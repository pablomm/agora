{
  "$comment": "Catalogue entries this pipeline provides, to be ingested into the Agora catalogue. Run details are in the output's .meta.json.",
  "entity_types": [
    {
      "id": "cadastral_zone",
      "label": {
        "es": "Masa catastral",
        "en": "Cadastral zone"
      },
      "label_plural": {
        "es": "Masas catastrales",
        "en": "Cadastral zones"
      },
      "description": "Catastro's zoning: urban blocks (manzanas) and rural polygons (polígonos).",
      "id_pattern": "es:catastro:zone:{catastro_municipality_code}:{reference}",
      "id_example": "es:catastro:zone:15015:73795NJ6077N",
      "key": {
        "name": "reference",
        "description": "Catastro's zoning reference; unique only within its Catastro municipality, hence the municipality code in the id.",
        "authority": "Dirección General del Catastro"
      },
      "subtypes": [
        "urban_block",
        "rural_polygon"
      ],
      "has_geometry": true
    },
    {
      "id": "cadastral_parcel",
      "label": {
        "es": "Parcela catastral urbana",
        "en": "Urban cadastral parcel"
      },
      "label_plural": {
        "es": "Parcelas catastrales urbanas",
        "en": "Urban cadastral parcels"
      },
      "description": "Urban land parcel, from the state Catastro or a foral cadastre (Navarra, Álava, Bizkaia, Gipuzkoa).",
      "id_pattern": "es:{source}:parcel:{source_municipality_code}:{reference}",
      "id_example": "es:catastro:parcel:28900:0000602VK4800A",
      "key": {
        "name": "reference",
        "description": "The source's parcel reference, unique within its municipality (hence the municipality in the id).",
        "authority": "Catastro or the foral cadastre"
      },
      "has_geometry": true
    },
    {
      "id": "rural_polygon",
      "label": {
        "es": "Polígono catastral",
        "en": "Cadastral polygon"
      },
      "label_plural": {
        "es": "Polígonos catastrales",
        "en": "Cadastral polygons"
      },
      "description": "Rural zoning that numbers rural parcels, from the state Catastro (its rural cadastral zones) or a foral cadastre.",
      "id_pattern": "es:catastro:zone:{municipality}:{reference} | es:{territory}:polygon:{municipality}:{polygon}",
      "id_example": "es:navarra:polygon:31001:001",
      "has_geometry": true
    }
  ],
  "relation_types": [
    {
      "id": "part_of",
      "from": "cadastral_zone",
      "to": "municipality",
      "description": "The IGN/INE municipality containing a point inside the zone (Catastro's own municipality codes differ from INE's).",
      "source_field": "parent_id"
    },
    {
      "id": "part_of",
      "from": "cadastral_parcel",
      "to": "cadastral_zone",
      "description": "The urban block the parcel lies in (state Catastro, 92 % of parcels).",
      "source_field": "zone_id"
    },
    {
      "id": "part_of",
      "from": "cadastral_parcel",
      "to": "municipality",
      "description": "The INE municipality the parcel lies in (by position).",
      "source_field": "municipality_code"
    },
    {
      "id": "part_of",
      "from": "rural_polygon",
      "to": "municipality",
      "description": "The INE municipality it lies in (by position).",
      "source_field": "parent_id"
    }
  ],
