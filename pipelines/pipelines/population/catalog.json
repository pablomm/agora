  "variables": [
    {
      "id": "population_total",
      "label": {
        "es": "Población",
        "en": "Population"
      },
      "unit": "personas",
      "facets": [
        {
          "dataset": "population_official",
          "filter": {
            "sex": "total"
          }
        },
        {
          "dataset": "population_sex_age",
          "filter": {
            "sex": "total",
            "age": "total"
          }
        }
      ],
      "default": {
        "census_section": "population_sex_age",
        "census_district": "population_sex_age",
        "municipality": "population_official",
        "province": "population_official",
        "autonomous_community": "population_official",
