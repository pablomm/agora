# Copy to .env.local to override. Values are shipped to the browser; never put private keys here.
# Basemap: any MapLibre style JSON. Defaults to OpenFreeMap Positron (no key needed).
# VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/positron
# Dark theme style. Defaults to OpenFreeMap Dark.
# VITE_MAP_DARK_STYLE_URL=https://tiles.openfreemap.org/styles/dark
# Tile server for the administrative boundaries (Martin, see ../tileserver). Defaults to the local one.
# VITE_TILES_URL=http://localhost:3000
